{
  "manifest_version": 3,
  "name": "Tam Phái · TikTok LIVE Local Bridge",
  "version": "1.0.0",
  "description": "Chuyển frame LIVE từ tab TikTok của bạn đến game chạy trên máy. Không dịch vụ ký, không gửi cookie.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8788/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [
    {"matches": ["https://www.tiktok.com/*"], "js": ["capture.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://www.tiktok.com/*"], "js": ["relay.js"], "run_at": "document_start"}
  ]
}
